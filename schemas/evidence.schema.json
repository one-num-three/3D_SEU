{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModuleEvidence",
  "type": "object",
  "required": [
    "task_id",
    "worker",
    "baseline_sha256",
    "artifacts",
    "sources",
    "assumptions",
    "qa"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "worker": {
      "type": "string"
    },
    "baseline_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1
    },
    "assumptions": {
      "type": "array"
    },
    "qa": {
      "type": "object"
    }
  }
}
